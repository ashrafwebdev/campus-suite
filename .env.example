APP_NAME="Campus Suite"
ENVIRONMENT=development

# SQLite by default. For Postgres: postgresql://user:password@localhost:5432/school
DATABASE_URL=sqlite:///./school.db

SECRET_KEY=change-me-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

FIRST_ADMIN_EMAIL=admin@example.com
FIRST_ADMIN_PASSWORD=changeme123

# Comma-separated origins allowed to call this API from a browser (the
# frontend's dev server and, once deployed, its real URL).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
