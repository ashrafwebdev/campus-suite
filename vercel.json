  "buildCommand": "cd frontend && npm install && npm run build",
  "outputDirectory": "frontend/dist",
  "rewrites": [{ "source": "/(.*)", "destination": "/index.html" }],
  "build": {
    "env": {
      "VITE_API_URL": "https://campus-suite-api.onrender.com",
      "VITE_APP_NAME": "SMA Campus Suite"
    }
  }
}
